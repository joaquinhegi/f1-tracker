# Self-hosted OpenF1 query API (infra/). Live + locally recorded sessions, current-season schedule.
OPENF1_SELF_HOSTED_URL=http://127.0.0.1:8000
# Public OpenF1. Free historical data since 2023; restricted while a session is live.
OPENF1_PUBLIC_URL=https://api.openf1.org
# Server-side JSON caches (circuit outlines). Defaults to web/.cache
# F1_CACHE_DIR=
